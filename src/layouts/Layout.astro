---
import "@/styles/globals.css";
import { ToastContainer } from "react-toastify";
// @ts-ignore
import { pwaInfo } from "virtual:pwa-info";

export interface Props {
    className?: string;
}

const { className } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/x-icon"
            href="/Hide-Seek-Madrid/favicon.ico"
        />
        <link
            rel="shortcut icon"
            type="image/x-icon"
            href="/Hide-Seek-Madrid/favicon.ico"
        />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/Hide-Seek-Madrid/apple-touch-icon.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/Hide-Seek-Madrid/favicon-32x32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/Hide-Seek-Madrid/favicon-16x16.png"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Oxygen:wght@300;400;700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
            rel="stylesheet"
        />
        <meta name="generator" content={Astro.generator} />
        <meta name="robots" content="noindex, nofollow" />
        <!-- HTML Meta Tags -->
        <title>Hide+Seek Madrid</title>
        <meta
            name="description"
            content="Mapa para jugar al escondite de Jet Lag en la Comunidad de Madrid."
        />

        <!-- Facebook Meta Tags -->
        <meta
            property="og:url"
            content="https://paramaxksp.github.io/Hide-Seek-Madrid/"
        />
        <meta property="og:type" content="website" />
        <meta
            property="og:title"
            content="Hide+Seek Madrid"
        />
        <meta
            property="og:description"
            content="Mapa para jugar al escondite de Jet Lag en la Comunidad de Madrid."
        />
        <meta
            property="og:image"
            content="https://paramaxksp.github.io/Hide-Seek-Madrid/JLIcon.png"
        />

        <!-- Twitter Meta Tags -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:domain" content="paramaxksp.github.io" />
        <meta
            property="twitter:url"
            content="https://paramaxksp.github.io/Hide-Seek-Madrid/"
        />
        <meta
            name="twitter:title"
            content="Hide+Seek Madrid"
        />
        <meta
            name="twitter:description"
            content="Mapa para jugar al escondite de Jet Lag en la Comunidad de Madrid."
        />
        <meta
            name="twitter:image"
            content="https://paramaxksp.github.io/Hide-Seek-Madrid/JLIcon.png"
        />

        {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
        <!-- Service worker: guarda la app y los datos para jugar sin conexión. -->
        <script is:inline src="/Hide-Seek-Madrid/registerSW.js"></script>
    </head>
    <body class:list={[className, "dark"]}>
        <slot />
        <ToastContainer client:only />
    </body>
</html>
